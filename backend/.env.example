# Copie para backend/.env e ajuste. Não versione o .env.

# development | staging | production
# Em production, SECRET_KEY passa a ser obrigatória.
ENVIRONMENT=development

# Chave de assinatura. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem valor, uma chave efêmera é gerada por processo (apenas em development).
SECRET_KEY=

# Chave anterior, só durante uma rotação. Enquanto definida, token assinado
# com ela e segredo de MFA cifrado com ela continuam válidos — e cada login
# com MFA migra o segredo para a chave atual sozinho. Remova quando não
# restar ninguém dependendo dela. Ver "Rotação" em docs/OPERACAO.md.
SECRET_KEY_PREVIOUS=

# --- De onde vêm os segredos (§12) ------------------------------------------
# env  = variáveis de ambiente (padrão)
# file = lê de SECRETS_DIR/<nome em minúsculas>, a convenção de todo cofre
#        que monta segredo como arquivo (Vault, Secrets Manager, Doppler,
#        Infisical, Docker/K8s secrets). Ambiente tem precedência sobre arquivo.
SECRETS_BACKEND=env
SECRETS_DIR=/run/secrets

# Banco de dados.
# SQLite é o padrão de desenvolvimento. Para o Postgres do docker-compose:
# DATABASE_URL=postgresql+psycopg2://atlas_user:atlas_password@localhost:5432/atlas_db
DATABASE_URL=sqlite:///./atlas_dev.db

# Armazenamento de documentos
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Origens permitidas para o frontend (JSON)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Armazenamento (§6.6) ---------------------------------------------------
# local = disco do servidor; s3 = bucket S3 ou compatível (MinIO)
STORAGE_BACKEND=local
# S3_BUCKET=atlas-documentos
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://localhost:9000   # MinIO
# S3_PREFIX=documents/

# Dias após a obsolescência em que o binário pode ser descartado.
# Zero desliga o expurgo. O registro do documento nunca é apagado.
OBSOLETE_RETENTION_DAYS=0

# --- Antivírus (§6.6) -------------------------------------------------------
# none = nenhuma varredura; o documento fica gravado como 'nao_verificado'
ANTIVIRUS_BACKEND=none
# ANTIVIRUS_HOST=127.0.0.1
# ANTIVIRUS_PORT=3310
# ANTIVIRUS_SOCKET=/var/run/clamav/clamd.ctl
# Em produção, recusar o que não pôde ser varrido:
ANTIVIRUS_REQUIRED=false

# --- Filas e workers (§6.7) -------------------------------------------------
# inline = executa no próprio processo da API, e o registro do trabalho diz isso
# redis  = entrega a um worker separado (python -m app.workers.worker)
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# --- Camada de IA (§3.3, §6.8) ----------------------------------------------
# none = sem modelo; o assistente responde por busca determinística no
# catálogo e diz que é isso que está fazendo.
AI_PROVIDER=none
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=60
# Horas de reaproveitamento de resposta idêntica. Zero desliga o cache.
AI_CACHE_HOURS=24

# --- Retenção de conteúdo (§6.6, LGPD) --------------------------------------
# Dias até que pergunta/resposta de IA e payload de trabalho sejam descartados.
# O registro permanece; o que sai é o conteúdo. Zero desliga — e guardar dado
# pessoal sem prazo é decisão, não inércia. Ver docs/LGPD.md.
AI_INTERACTION_RETENTION_DAYS=0
JOB_RECORD_RETENTION_DAYS=0
